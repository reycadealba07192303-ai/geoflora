# Template for apps/web/.env.local (copy it there and fill in the blanks). Safe to commit: no secrets here.
# Read by the web app (Next.js) and by the Python side (inference service, training worker, collection scripts)
# through services/ml/src/geoflora_ml/env.py. Never commit this file: .env.* is gitignored.
# Values already set in the environment override this file (test scripts rely on that).

# ── Database ──
# Development: local MongoDB 8.0 (data files in C:\Program Files\MongoDB\Server\8.0\data).
# Hosted (Vercel): the MongoDB Atlas connection string, mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/geoflora
GEOFLORA_MONGODB_URI=mongodb://127.0.0.1:27017/geoflora
# Database name for the catalog import scripts (the URI above already names it for the web app).
GEOFLORA_MONGODB_DATABASE=geoflora

# ── Image classifier service (FastAPI, services/ml) ──
GEOFLORA_ML_API_URL=http://127.0.0.1:8000
GEOFLORA_INFERENCE_TIMEOUT_MS=50000
# Leave unset: storage/models/active_model.json holds the validation-selected threshold. Setting this overrides it.
# GEOFLORA_CONFIDENCE_THRESHOLD=0.8

# ── Hosting (Vercel + Hugging Face Space + MongoDB Atlas; see docs/deploy-vercel.md) ──
# Shared key between the web app and the classifier service. Set the same value on Vercel and on the Space.
GEOFLORA_ML_API_KEY=
# Lets the training computer tell the Space to load a newly promoted model. Same value here and on the Space.
GEOFLORA_ML_RELOAD_TOKEN=
# Hugging Face model repository the Space downloads its model from, e.g. your-name/geoflora-model, and a write token
# for this computer to upload promoted models (huggingface.co > Settings > Access Tokens).
GEOFLORA_MODEL_REPO=
HF_TOKEN=
# Vercel Cron sends this to /api/cron/ai-review. Set the same value as CRON_SECRET on Vercel.
CRON_SECRET=
# Extra site addresses allowed to call the API from a browser (comma-separated), e.g. a custom domain.
GEOFLORA_ALLOWED_ORIGINS=

# ── Email (account verification and password reset codes) ──
# Gmail address and a 16-letter Google App Password (Google Account > Security > 2-Step Verification > App passwords).
GEOFLORA_SMTP_USER=
GEOFLORA_SMTP_PASSWORD=
GEOFLORA_SMTP_HOST=smtp.gmail.com
# Sender name shown in the inbox.
GEOFLORA_SMTP_FROM_NAME=geoflora
GEOFLORA_SMTP_PORT=465

# ── AI reviewer and plant suggestions ──
# OpenRouter key (free vision models). When it is set, OpenRouter is used; otherwise Claude with ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=
# Models tried in order on OpenRouter (comma-separated).
GEOFLORA_AI_REVIEW_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# "off" turns the automatic sighting reviewer off; "on" forces it on when credentials come from elsewhere.
GEOFLORA_AI_REVIEW=
# ANTHROPIC_API_KEY=

# ── Automatic training ──
# Verified, consented reports needed before a training job is queued. Training creates an experimental candidate;
# promotion is never automatic and requires an administrator to approve its saved evaluation in Review & training.
GEOFLORA_MIN_TRAINING_REPORTS=1
# Minimum distinct reviewed observation groups for a species before its report photos can queue training.
GEOFLORA_MIN_TRAINING_GROUPS_PER_CLASS=10

# ── Photo collection and GBIF catalog downloads ──
# Contact email sent in the User-Agent to iNaturalist and GBIF (good API citizenship).
GEOFLORA_CONTACT_EMAIL=
# GBIF account, needed only to request a new occurrence download (scripts/species_catalog/gbif_species_list.py).
GBIF_USER=
GBIF_PASSWORD=
GBIF_EMAIL=

# ── Optional ──
# 1 = leave the OpenStreetMap street map out of report PDFs (for use without internet).
# GEOFLORA_OFFLINE_MAP=
